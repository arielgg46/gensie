\BKM@entry{id=12,dest={73656374696F6E2E37},srcline={1}}{}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Field-aware pair selection as a vector objective. Each axis is a query-field similarity component \(a_i\); actual retrieval vectors are \(m\)-dimensional. A redundant pair concentrates evidence in similar directions, so \(v_1-v_2\) is short. A complementary pair covers different field dimensions, increasing both the joint vector \(v_1+v_2\) and the difference vector \(v_1-v_2\) used by the pair score.}}{12}{figure.4}\protected@file@percent }
\newlabel{fig:field-aware-pair-selection}{{4}{12}{Field-aware pair selection as a vector objective. Each axis is a query-field similarity component \(a_i\); actual retrieval vectors are \(m\)-dimensional. A redundant pair concentrates evidence in similar directions, so \(v_1-v_2\) is short. A complementary pair covers different field dimensions, increasing both the joint vector \(v_1+v_2\) and the difference vector \(v_1-v_2\) used by the pair score}{figure.4}{}}
